# =========================================================================
# ==================== CLOCK CONSTRAINTS SECTION ==========================
# =========================================================================

# 1. יצירת שעון עבור RGMII TX 
# (הנתיב תוקן כך שיתאים לאינסטנציה הקיימת בקוד ה-Verilog שלך)
create_generated_clock -name rgmii_tx_clk -source [get_pins gmii_to_rgmii_inst/ODDR_rgmii_clk/C] -divide_by 1 [get_ports rgmii_tx_clk]

# 2. הגדרת שעוני הבסיס המרכזיים
create_clock -period 20.000 -name Clk -waveform {0.000 10.000} -add [get_ports Clk]
create_clock -period 8.000 -name rgmii_rx_clk_i -waveform {0.000 4.000} -add [get_ports rgmii_rx_clk_i]

# 3. הפרדת דומיינים (CDC) למניעת בעיות Setup/Hold (TIMING-6, TIMING-7)
# הגדרה זו מבהירה ל-Vivado שאין קשר תזמוני בין שעוני האתרנט לשעוני המערכת, 
# ומאפשרת ל-Async FIFO לטפל במעבר המידע ללא שגיאות תזמון.
set_clock_groups -asynchronous \
    -group [get_clocks -include_generated_clocks Clk] \
    -group [get_clocks -include_generated_clocks rgmii_rx_clk_i]

# =========================================================================


